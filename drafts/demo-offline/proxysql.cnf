# Bintrail offline demo — minimal ProxySQL config.
#
# Only carries admin reachability and protocol bind addresses;
# the routing config (mysql_servers / mysql_users / mysql_query_rules)
# is loaded at runtime by piping `bintrail proxysql-config` into
# the admin port.
#
# Note on the `radminuser` credential: ProxySQL hardcodes the literal
# username `admin` as loopback-only — connecting to admin from another
# container by that name fails with `Error 1040: User 'admin' can only
# connect locally`. Adding any non-`admin` credential to
# admin_credentials lets us reach the admin interface from the
# proxysql-setup container. The stock `admin:admin` is kept for
# loopback access from inside the proxysql container.

datadir="/var/lib/proxysql"

admin_variables=
{
    admin_credentials="admin:admin;radminuser:radminpw"
    mysql_ifaces="0.0.0.0:6032"
}

mysql_variables=
{
    interfaces="0.0.0.0:6033"
    server_version="8.0.0"
    monitor_username="monitor"
    monitor_password="monitor"
    default_authentication_plugin="mysql_native_password"
}
